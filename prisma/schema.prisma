// This is your Prisma schema file

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

model User {
  id                String           @id @default(auto()) @map("_id") @db.ObjectId
  name              String?
  email             String           @unique
  emailVerified     DateTime?
  image             String?
  password          String?
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt
  verificationToken String?          @default(cuid())
  deleted           Boolean          @default(false)
  accounts          Account[]
  sessions          Session[]
  chatbots          Chatbot[]
  verifiedDomains   VerifiedDomain[]
}

model Account {
  id                String  @id @default(auto()) @map("_id") @db.ObjectId
  userId            String  @db.ObjectId
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(auto()) @map("_id") @db.ObjectId
  sessionToken String   @unique
  userId       String   @db.ObjectId
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  id         String   @id @default(auto()) @map("_id") @db.ObjectId
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Chatbot {
  id              String         @id @default(auto()) @map("_id") @db.ObjectId
  userId          String         @db.ObjectId
  name            String         @default("AI Assistant")
  welcomeMessage  String         @default("Hello! How can I help you today?")
  tone            String         @default("professional")
  systemPrompt    String         @default("You are a helpful AI assistant. Answer questions based on the provided context.")
  agentType       String         @default("general")
  primaryColor    String         @default("#6366f1")
  assistantLogo   String?
  websiteLogo     String?
  supportEmail    String?
  supportPhone    String?
  supportWhatsapp String?
  contactPageLink String?
  theme           String         @default("light") // light, dark
  status          String         @default("training") // training, ready, inactive
  totalQueries    Int            @default(0)
  deleted         Boolean        @default(false)
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  user            User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  dataSources     DataSource[]
  conversations   Conversation[]
}

model DataSource {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  chatbotId String   @db.ObjectId
  url       String
  title     String   @default("")
  content   String   @default("")
  wordCount Int      @default(0)
  status    String   @default("pending") // pending, indexed, failed
  deleted   Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  chatbot   Chatbot  @relation(fields: [chatbotId], references: [id], onDelete: Cascade)

  @@unique([chatbotId, url])
}

model Conversation {
  id        String    @id @default(auto()) @map("_id") @db.ObjectId
  chatbotId String    @db.ObjectId
  sessionId String    @default(cuid())
  deleted   Boolean   @default(false)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  chatbot   Chatbot   @relation(fields: [chatbotId], references: [id], onDelete: Cascade)
  messages  Message[]
}

model Message {
  id             String       @id @default(auto()) @map("_id") @db.ObjectId
  conversationId String       @db.ObjectId
  role           String // user, assistant
  content        String
  isError        Boolean      @default(false)
  deleted        Boolean      @default(false)
  feedback       String? // helpful, unhelpful
  confidence     Float?       @default(1.0)
  unanswered     Boolean      @default(false)
  category       String? // pricing, product, support, other
  sourceUrls     String[]
  createdAt      DateTime     @default(now())
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
}

model VerifiedDomain {
  id                String    @id @default(auto()) @map("_id") @db.ObjectId
  userId            String    @db.ObjectId
  domain            String
  verified          Boolean   @default(false)
  verificationEmail String?
  verificationCode  String?
  codeExpiresAt     DateTime?
  deleted           Boolean   @default(false)
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  user              User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, domain])
}

model Enquiry {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  email       String
  mobile      String? // Optional phone number
  plan        String // Starter, Premium
  description String?
  createdAt   DateTime @default(now())
}
